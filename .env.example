# Heimdall Configuration

# Server
APP_HOST=0.0.0.0
APP_PORT=8080

# Database (PostgreSQL)
DATABASE_URL=postgres://heimdall:heimdall@localhost:5432/heimdall

# Logging
RUST_LOG=info,heimdall=debug

# AI Providers (BYOK — set at least one)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OLLAMA_URL=http://localhost:11434

# OAuth (for GitHub/GitLab repo connections)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:8080/auth/github/callback
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# GITLAB_REDIRECT_URI=http://localhost:8080/auth/gitlab/callback

# Security
# SESSION_SECRET=<random-64-char-hex>
# ENCRYPTION_KEY=<random-32-byte-hex-for-api-key-encryption>
