# =============================================================================
# Heimdall Configuration
# Copy to .env and fill in the values for your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# Bind address (default: 0.0.0.0)
APP_HOST=0.0.0.0

# Listen port (default: 8080)
APP_PORT=8080

# Enable TLS termination in the app (default: false)
# Set to true only if Heimdall handles TLS directly (not behind a reverse proxy)
TLS_ENABLED=false

# Allowed CORS origin (default: http://localhost:8080)
CORS_ALLOWED_ORIGIN=http://localhost:8080

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# PostgreSQL connection string (REQUIRED)
# Full Docker Compose stack: use the service hostname.
DATABASE_URL=postgres://heimdall:heimdall@postgres:5432/heimdall
# If running Heimdall on the host instead of in Docker, use localhost:
# DATABASE_URL=postgres://heimdall:heimdall@localhost:5432/heimdall

# Docker Compose database password
# Heimdall currently supports PostgreSQL as its runtime database.
# Override these for non-local deployments.
POSTGRES_PASSWORD=heimdall

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Rust log filter (see https://docs.rs/env_logger)
RUST_LOG=info,heimdall=debug

# -----------------------------------------------------------------------------
# MCP Server
# -----------------------------------------------------------------------------

# Heimdall MCP defaults to stdio, which is the recommended local setup.
# Enable HTTP only when your client cannot spawn the binary directly.
# MCP_TRANSPORT=http
# MCP_HOST=127.0.0.1
# MCP_PORT=45637
# Public OAuth issuer/resource URL for HTTP MCP clients.
# Defaults to http://<MCP_HOST>:<MCP_PORT>, with 0.0.0.0 mapped to localhost.
# MCP_PUBLIC_BASE_URL=http://127.0.0.1:45637

# Public web app URL used when MCP OAuth needs the user to sign in first.
# Defaults to the configured app host/port.
# APP_PUBLIC_BASE_URL=http://localhost:8080

# Optional single-user fallback for local stdio clients.
# If unset, stdio MCP callers must pass an explicit user_id in tool inputs.
# HTTP MCP derives user identity from OAuth and ignores this fallback.
MCP_DEFAULT_USER_ID=

# -----------------------------------------------------------------------------
# AI Providers (server-level BYOK fallback)
# -----------------------------------------------------------------------------

# Claude Code, Codex, and Grok Subscription are connected per user from
# Settings; they do not use server environment variables. The variables below
# are server-level BYOK providers and are used when no stored user provider
# takes precedence.

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# OpenAI-compatible custom endpoint
# Supports base URLs with or without /v1, e.g. http://localhost:1234/v1
OPENAI_COMPATIBLE_BASE_URL=
# Required model id exposed by the custom endpoint
OPENAI_COMPATIBLE_MODEL=
# Optional for endpoints that require auth
OPENAI_COMPATIBLE_API_KEY=

# xAI (Grok / Grok Build)
XAI_API_KEY=
# Grok Subscription OAuth defaults to local loopback mode.
# For hosted deployments, register/use an xAI OAuth client for your domain and set:
# XAI_OAUTH_REDIRECT_URI=https://your-domain.example/api/settings/xai-oauth/callback
# XAI_OAUTH_CLIENT_ID=
# XAI_OAUTH_CLIENT_SECRET=
# Docker Compose publishes this fixed browser callback port for local loopback mode.
XAI_OAUTH_CALLBACK_PORT=56121

# Ollama (local inference)
OLLAMA_URL=

# Default model to use when none is specified
# (default: claude-sonnet-4-20250514)
DEFAULT_AI_MODEL=claude-sonnet-4-20250514

# -----------------------------------------------------------------------------
# OAuth — GitHub / GitLab repo connections
# -----------------------------------------------------------------------------

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/auth/github/callback

GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=http://localhost:8080/api/auth/gitlab/callback
GITLAB_BASE_URL=https://gitlab.com

# Planned GitHub App integration
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

# Random 64-char hex string for signing session cookies
# Generate with: openssl rand -hex 32
# SESSION_SECRET=

# Random 32-byte hex key for AES-GCM encryption of stored API keys
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Shared secret for GitHub / GitLab webhook verification
# Generate with: openssl rand -hex 20
WEBHOOK_SECRET=
